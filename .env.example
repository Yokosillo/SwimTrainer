# Copiar a .env (que no se sube al repositorio) y poner valores de verdad.
#
# Usuario y contrasenia del panel. Sin ENTRENADOR_CLAVE el servidor queda abierto: solo vale
# para 127.0.0.1 en el PC de casa, nunca detras de un proxy o en red.
ENTRENADOR_USUARIO=atleta
ENTRENADOR_CLAVE=cambia-esta-contrasenia

# 1 = rehacer el cuadro de mando al arrancar (recomendado si los datos cambian fuera del portal).
ENTRENADOR_REGENERAR=1
# 1 = rehacer tambien el portal de bici (tarda mas; se puede poner 0 y generarlo a mano).
ENTRENADOR_PORTAL_BICI=1

# Motor de conocimiento: v1 = el actual (por defecto). v2 se activara en la fase F5.
# Un valor desconocido cae a v1. Se lee en un unico sitio: conocimiento.motor_version().
MOTOR_CONOCIMIENTO=v1

# Motor de recomendaciones: v1 = el actual (por defecto); v2 = opciones/puntuación; dual = compara sin tocar la base.
# El comando explícito `cli motor` usa v2 salvo que se indique --motor v1.
MOTOR_RECOMENDACION=v1

# UID/GID del usuario del host que es dueno de data/, informes/ y cuadro/ (id -u; id -g).
ENTRENADOR_UID=1001
ENTRENADOR_GID=1001

# Capa LLM opcional para explicar recomendaciones (F8). Apagada por defecto.
# La clave se queda en el servidor; nunca se envia al navegador ni se versiona.
COACH_ENABLED=0
COACH_BASE_URL=
COACH_MODEL=
COACH_API_KEY=
COACH_TIMEOUT=20
COACH_MAX_TOKENS=700
