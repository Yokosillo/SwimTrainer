# Lo que NO se sube al repositorio

# Entorno y dependencias (se reinstalan; ver requirements.txt y package.json)
.venv/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Datos personales del atleta: nunca al repositorio
# Los anexos (informes/) llevan sus marcas, sus ritmos y lo del hombro: se quedan en el PC. El repositorio
# publico lleva el codigo, no el historial medico-deportivo.
informes/

# El otro repositorio (el privado, con los datos): vive aqui dentro pero es su propio git
privado/
data/
export_*.zip
*.db
*.db-wal
*.db-shm
*.fit
*.gpx
*.tcx

# Salidas generadas (se rehacen con `cli analizar`)
cuadro/
data/derived/

# El nombre, el club y el sello del atleta: los lee entrenador/perfil.py desde aqui
entrenador/perfil_local.py
# El plan personal (objetivos, marcas, fechas, semanas y decisiones): lo lee entrenador/plan.py desde aqui
entrenador/plan_local.py

# Overlay privado del conocimiento (reglas, criterios y textos del atleta)
conocimiento/local/

# Despliegue en Docker: la contrasenia del panel y el token de Garmin no se suben
.env
.garminconnect/
docker-compose.override.yml

# Cosas sueltas de una sesion de trabajo
*.log
tmp-*
*.tmp
